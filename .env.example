# ─────────────────────────────────────────────────────────────────────────────
# CasaRenous — variables d'environnement
# Copier vers .env, puis générer les secrets :
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#   npx web-push generate-vapid-keys
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_ORIGIN=https://casarenous.martylab.fr
# Origines supplémentaires autorisées (dev uniquement), séparées par des virgules.
EXTRA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=1
LOG_LEVEL=info
TZ=Europe/Paris

# PostgreSQL (hôte = db dans compose, localhost en dev)
DATABASE_URL=postgresql://casarenous:casarenous@localhost:5432/casarenous

# Secrets — 32 caractères minimum. Ne jamais committer.
SESSION_SECRET=remplace-moi-par-48-octets-aleatoires-base64url
OTP_PEPPER=remplace-moi-par-48-octets-aleatoires-base64url
# Clé AES-256-GCM : 32 octets encodés en base64.
FILE_ENCRYPTION_KEY=remplace-moi-par-32-octets-base64

# Import catalogue Leroy Merlin (API.SH, 1000 crédits gratuits/mois).
# APISH_KEY=cle-api-sh

# Sessions
SESSION_TTL_SECONDS=1209600
SESSION_IDLE_SECONDS=86400
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# false en développement HTTP ; true (forcé) en production derrière HTTPS
COOKIE_SECURE=false

# Mailer : console (dev uniquement) ou smtp (production)
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM=CasaRenous <no-reply@casarenous.martylab.fr>

# Push VAPID (production). Générer avec : npx web-push generate-vapid-keys
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@casarenous.martylab.fr

# Stockage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# Seed — obligatoire en production. En développement, des mots de passe
# aléatoires sont générés et affichés une seule fois si absents.
# Utilise une VRAIE adresse email : l'OTP de connexion y sera envoyé.
SEED_ADMIN_EMAIL=admin@exemple.fr
SEED_ADMIN_NAME=Administrateur CasaRenous
SEED_ADMIN_PASSWORD=
# Second administrateur optionnel, créé uniquement au seed.
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_NAME=
SEED_ADMIN_2_PASSWORD=
SEED_INVITE_1_EMAIL=sevin@casarenous.fr
SEED_INVITE_1_NAME=Mme Sévin
SEED_INVITE_1_PASSWORD=
SEED_INVITE_2_EMAIL=renous@casarenous.fr
SEED_INVITE_2_NAME=M. Renous
SEED_INVITE_2_PASSWORD=
SEED_ON_START=false

# Postgres (compose)
POSTGRES_DB=casarenous
POSTGRES_USER=casarenous
POSTGRES_PASSWORD=remplace-moi
